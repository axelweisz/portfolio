---
// Shows the cover with a Play button; the game (often 20–50 MB) only loads when clicked.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string; // e.g. /demos/scurry/
  title: string;
  cover: ImageMetadata;
  hint?: string;
  aspect?: string;
}
const { src, title, cover, hint = 'Desktop browser · keyboard', aspect = '16 / 10' } = Astro.props;
const bg = await getImage({ src: cover, width: 1280 });
---

<div class="demo" data-src={src} data-title={title} style={`background-image:url(${bg.src});aspect-ratio:${aspect}`}>
  <div class="overlay">
    <button type="button" class="pill play">▶ Play in browser</button>
    <span class="hint">{hint}</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.demo[data-src]').forEach((el) => {
    el.querySelector('.play')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = el.dataset.src!;
      f.title = el.dataset.title || 'Playable demo';
      f.allow = 'fullscreen; autoplay; gamepad; midi';
      f.setAttribute('allowfullscreen', '');
      el.replaceChildren(f);
      el.style.backgroundImage = 'none';
      f.focus();
    });
  });
</script>

<style>
  .demo {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #000 center / cover no-repeat;
    border: 1px solid var(--line);
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: rgba(7, 24, 39, 0.55);
  }
  .play { background: var(--bg); color: var(--text); font-size: 1rem; padding: 0.5em 1.4em; cursor: pointer; }
  .hint { font-size: 0.75rem; color: var(--text); opacity: 0.8; }
  .demo :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
