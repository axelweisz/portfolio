---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string; // path or URL of the preview image (1200×630 works best)
}
const {
  title,
  description = `${site.firstName} ${site.lastName} — ${site.tagline.join(', ')}. Based in Montréal.`,
  image = '/og-default.png',
} = Astro.props;
// Absolute addresses for link previews (uses `site` from astro.config.mjs)
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const fullTitle = title ? `${title} — ${site.firstName} ${site.lastName}` : `${site.firstName} ${site.lastName} — Portfolio`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/projects') : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={pageUrl} />

    <!-- Link previews (WhatsApp, LinkedIn, Facebook, iMessage, Slack, X…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.firstName} ${site.lastName}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body id="top">
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="pill home" aria-label="Home">~/home</a>
        <nav>
          <span class="glyph" aria-hidden="true">&lt;/&gt;</span>
          {site.nav.map((item) => (
            <a href={item.href} class:list={{ active: isActive(item.href) }}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <hr class="hairline" />
      <div class="wrap foot">
        <span>© {new Date().getFullYear()} {site.firstName} {site.lastName}</span>
        <a href="#top" class="pill" aria-label="Back to top">↑</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { padding: 1.75rem 0; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  nav { display: flex; gap: clamp(1rem, 3vw, 2.75rem); align-items: center; font-size: 0.95rem; }
  nav a { position: relative; padding: 0.2em 0; color: var(--text); opacity: 0.8; transition: opacity 0.2s; }
  nav a:hover, nav a.active { opacity: 1; }
  nav a.active::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: var(--coral);
  }
  .glyph { color: var(--muted); }
  .site-footer { margin-top: 6rem; }
  .foot { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem var(--pad); font-size: 0.8rem; color: var(--muted); }
  @media (max-width: 640px) { .glyph { display: none; } }
</style>
