---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import PlayableDemo from '../../components/PlayableDemo.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, role, client, credits, award, tools, video, moreVideos, demo, demoAspect, demoHint, poster, cover, links, status } = project.data;
const { Content } = await render(project);
const logs = (await getCollection('logs', ({ data }) => !data.draft && data.project === project.id)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const posterImg = await getImage({ src: poster ?? cover, width: 1280 });
// Link preview: the project's cover, plus the first ~160 characters of its paragraph
const previewImg = await getImage({ src: cover, width: 1200, format: 'jpg' });
const plain = (project.body ?? '').replace(/\s+/g, ' ').trim();
const description = plain.length > 160 ? plain.slice(0, plain.lastIndexOf(' ', 157)) + '…' : plain;
---

<Base title={title} description={description} image={previewImg.src}>
  <article class="wrap project">
    <p class="crumb">▸ ▣ <a href="/"><b>Work</b></a> ▸ <span class="hl">{title}</span></p>

    <div class="media">
      {video ? (
        <Video src={video} title={title} poster={posterImg.src} />
      ) : demo ? (
        <PlayableDemo src={demo} title={title} cover={poster ?? cover} aspect={demoAspect} hint={demoHint} />
      ) : (
        <Image src={poster ?? cover} alt={title} widths={[800, 1280]} sizes="100vw" class="still" />
      )}
    </div>

    <header class="head">
      <div>
        <h1>{title}</h1>
        {award && <p class="award">★ {award}</p>}
      </div>
      <ul class="meta">
        {client && <li><span>_client</span>{client}</li>}
        {role && <li><span>_role</span>{role}</li>}
        {credits && <li><span>_credits</span>{credits}</li>}
        {tools.length > 0 && <li><span>_tools</span>{tools.join(', ')}</li>}
        {status === 'active' && <li><span>_status</span><em>active</em></li>}
      </ul>
    </header>

    <div class="prose">
      <Content />
    </div>

    {moreVideos.length > 0 && (
      <section class="more">
        {moreVideos.map((v) => (
          <figure>
            <Video src={v.src} title={v.title} autoplay={false} />
            <figcaption class="crumb">▸ {v.title}</figcaption>
          </figure>
        ))}
      </section>
    )}

    {demo && video && (
      <section class="demo-below">
        <p class="crumb">▸ <span class="hl">Play the prototype</span></p>
        <PlayableDemo src={demo} title={title} cover={poster ?? cover} aspect={demoAspect} hint={demoHint} />
      </section>
    )}

    {(links.repo || links.site) && (
      <p class="links">
        {links.site && <a class="pill" href={links.site} target="_blank" rel="noopener">Visit ↗</a>}
        {links.repo && <a class="pill" href={links.repo} target="_blank" rel="noopener">Code ↗</a>}
      </p>
    )}

    {logs.length > 0 && (
      <section class="logs">
        <p class="crumb">▸ <span class="hl">Progress log</span></p>
        <ul>
          {logs.map((l) => (
            <li><a href={`/log#${l.id}`}><span class="date">{l.data.date.toISOString().slice(0, 10)}</span> {l.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <nav class="pager">
      {prev ? <a href={`/projects/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/projects/${next.id}/`}>{next.data.title} →</a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .project { padding-top: 1rem; }
  .media { margin-top: 1.25rem; }
  .still { width: 100%; height: auto; border: 1px solid var(--line); }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 2.25rem 0 1.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.75rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    margin: 0;
  }
  .meta { list-style: none; margin: 0; padding: 0; font-size: 0.85rem; display: grid; gap: 0.2rem; }
  .meta li { display: grid; grid-template-columns: 6.5rem 1fr; }
  .meta span { color: var(--coral); }
  .meta em { color: var(--teal); font-style: normal; }
  .award { color: var(--teal); margin: 0.75rem 0 0; font-size: 0.9rem; }
  .meta { max-width: 32rem; }
  .more { margin-top: 3rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 2rem; }
  .more figure { margin: 0; }
  .more figcaption { margin-top: 0.6rem; }
  .demo-below { margin-top: 3rem; }
  .demo-below :global(.demo) { margin-top: 0.75rem; }
  .links { display: flex; gap: 0.75rem; margin-top: 2rem; }
  .logs { margin-top: 3rem; }
  .logs ul { list-style: none; padding: 0; margin: 0.75rem 0 0; }
  .logs li { padding: 0.5rem 0; border-bottom: 1px solid var(--line); }
  .logs .date { color: var(--teal); margin-right: 1rem; }
  .pager {
    display: flex;
    justify-content: space-between;
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .pager a:hover { color: var(--coral); }
</style>
