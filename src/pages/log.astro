---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entries = (await getCollection('logs', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const posts = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
const projects = new Map((await getCollection('projects')).map((p) => [p.id, p.data.title]));
---

<Base title="Log">
  <section class="wrap">
    <p class="crumb">▸ ▣ <b>Portfolio</b> ▸ <span class="hl">Log</span></p>
    <h1>Log</h1>
    <p class="prompt teal">progress on current prototypes</p>

    {posts.length === 0 && <p class="empty">// nothing posted yet</p>}

    {posts.map(({ e, Content }) => (
      <article id={e.id} class="post">
        <div class="side">
          <span class="date">{e.data.date.toISOString().slice(0, 10)}</span>
          {e.data.project && (
            <a href={`/projects/${e.data.project}/`} class="proj">{projects.get(e.data.project) ?? e.data.project}</a>
          )}
        </div>
        <div>
          <h2>{e.data.title}</h2>
          <div class="prose"><Content /></div>
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
  h1 { font-family: var(--font-display); font-size: clamp(2.5rem, 7vw, 4.5rem); margin: 1.5rem 0 0.25rem; line-height: 1; }
  .empty { color: var(--muted); margin-top: 3rem; }
  .post {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .post:first-of-type { margin-top: 2rem; border-top: 1px solid var(--line); }
  .side { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.85rem; }
  .date { color: var(--teal); }
  .proj { color: var(--coral); }
  h2 { font-family: var(--font-display); font-size: 1.5rem; margin: 0 0 0.75rem; }
  @media (max-width: 720px) { .post { grid-template-columns: 1fr; gap: 0.75rem; } }
</style>
